# =============================================================================
# COMEXT Pipeline — Environment Variables
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# When running with Docker, these are loaded automatically via env_file in
# docker-compose.yml. For local development, python-dotenv loads them at
# startup.
#
# NOTE: Never commit .env — it is in .gitignore. Only .env.example is tracked.
# =============================================================================

# -----------------------------------------------------------------------------
# Data directories
# In Docker: use absolute /data paths (matches the comext_data_dev volume mount at /data)
# For local development without Docker: change these to ./data/raw etc.
COMEXT_DATA_DIR=./data
COMEXT_RAW_DIR=./data/raw
COMEXT_PROCESSED_DIR=./data/processed
COMEXT_DB_PATH=./data/comext.duckdb

# -----------------------------------------------------------------------------
# Eurostat API
# -----------------------------------------------------------------------------
# Base URL for the Eurostat bulk download API (no trailing slash needed).
EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination/files/

# Seconds to wait between consecutive HTTP requests — be polite to the API.
EUROSTAT_REQUEST_DELAY=1.0

# -----------------------------------------------------------------------------
# Pipeline behaviour
# -----------------------------------------------------------------------------
# Number of months to check for revisions on each sensor tick.
# Eurostat revises up to ~24 months of historical data, so 24 is the safe max.
REVISION_WINDOW_MONTHS=24

# How often the sensor polls Eurostat for new/updated files (in seconds).
# Default: 1800 = 30 minutes.
SENSOR_MINIMUM_INTERVAL_SECONDS=1800

# Delete raw .7z / .dat files older than N months to save disk space.
# Set to 0 to keep all raw files indefinitely (recommended for auditability).
RAW_RETENTION_MONTHS=0

# Fraction of rows allowed to fail validation before the run is aborted.
# 0.0 = any validation error only logs a warning (run still succeeds).
# 0.01 = abort if more than 1% of rows are invalid.
MAX_VALIDATION_ERROR_RATIO=0.0

# -----------------------------------------------------------------------------
# API resilience
# -----------------------------------------------------------------------------
# Maximum number of retry attempts for failed HTTP requests.
API_RETRY_MAX_ATTEMPTS=3

# Number of consecutive failures before the circuit breaker opens (stops retrying).
API_CIRCUIT_BREAKER_THRESHOLD=5

# Seconds to wait before the circuit breaker allows requests again after opening.
API_CIRCUIT_BREAKER_TIMEOUT=60.0

# -----------------------------------------------------------------------------
# Dagster
# -----------------------------------------------------------------------------
# Where Dagster stores its run history, event log, and schedule state.
# In Docker this is set to /app/.dagster via the Dockerfile ENV block.
# Uncomment and set this only for local development outside Docker.
# DAGSTER_HOME=./.dagster
